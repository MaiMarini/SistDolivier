# Configuração local (cada loja tem a sua; nunca versionar)
app/config.php

# Variáveis de ambiente (segredos: banco, SMTP, tokens)
.env

# Uploads enviados pela loja (mantém só a pasta, não o conteúdo)
assets/uploads/*
!assets/uploads/.gitkeep

# Logs
*.log

# Sessões guardadas dentro do projeto (quando não dá para usar a pasta fora do public_html)
app/sessoes/