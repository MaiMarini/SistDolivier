# Copie este arquivo para ".env" (na raiz) e preencha com os valores reais.
# O .env NÃO é versionado (contém segredos: senhas, tokens).

# --- Banco de dados (MySQL) ---
DB_HOST=localhost
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco

# URL base do site, SEM barra no final.
BASE_URL=https://dolivier.com.br

# Ambiente: dev (mostra erros) | prod (esconde)
APP_ENV=prod

# --- Mercado Pago (Checkout Pro) ---
# Com MP_ACCESS_TOKEN vazio, o pagamento online fica desligado (pedido "pendente",
# combinado pelo WhatsApp). Comece com as credenciais de TESTE.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Assinatura secreta do webhook (Suas integrações › Webhooks › "Assinatura secreta").
MP_WEBHOOK_SECRET=

# --- Google Maps (frete por distância) ---
GOOGLE_MAPS_API_KEY=

# --- Sessão (opcional, só para testes) ---
# Minutos sem uso até o admin sair da conta (padrão: 120). Use 1 para testar
# a expiração e depois apague a linha.
# SESSAO_ADMIN_MINUTOS=

# --- E-mail (SMTP, passo 4.2) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=