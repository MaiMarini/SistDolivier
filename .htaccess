# Front controller: envia tudo que NÃO for arquivo/pasta real para o index.php.
# Mantém URLs limpas (ex.: /produto/vela-aromatica -> index.php).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se preciso, ajuste a base quando o site rodar em subpasta (ex.: RewriteBase /loja/).
    # RewriteBase /

    # Pastas internas do Git e do GitHub nunca são servidas (403).
    RewriteRule (^|/)\.(git|github)(/|$) - [F,L]

    # Não reescreve arquivos existentes (CSS, JS, imagens, uploads...).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo o resto vai para o front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Página de erro 404 também passa pelo roteador.
ErrorDocument 404 /index.php

# Bloqueia listagem de diretórios.
Options -Indexes

# Nega acesso web a arquivos sensíveis: todo arquivo que começa com ponto (.env,
# .env.example, .gitignore, .htaccess...) e scripts SQL, logs e backups.
# São arquivos reais, então a regra de reescrita os serviria — este bloco impede.
<FilesMatch "(^\.|\.(sql|log|ini|bak|sh)$|^error_log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeçalhos de segurança (também enviados pelo PHP nas páginas). "set" substitui o
# do PHP, sem duplicar. Sem Content-Security-Policy por enquanto: ela pode quebrar
# o checkout do Mercado Pago e as fontes.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>